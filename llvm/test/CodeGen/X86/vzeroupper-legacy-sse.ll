; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-unknown -mattr=+avx2,+sha,+kl,+widekl,+sse4a | FileCheck %s --check-prefixes=CHECK,AVX2
; RUN: llc < %s -mtriple=x86_64-unknown-unknown -mattr=+avx512f,+avx512vl,+sha,+kl,+widekl,+sse4a | FileCheck %s --check-prefixes=CHECK,AVX512

; A handful of extensions have no VEX encoding, so the backend emits them as
; legacy SSE even in an otherwise-AVX function. They therefore take the
; AVX/SSE transition penalty themselves whenever a 256/512-bit operation has
; left the upper YMM/ZMM state dirty, and need a vzeroupper in front of them
; rather than only in the function epilogue.

declare <4 x i32> @llvm.x86.sha256rnds2(<4 x i32>, <4 x i32>, <4 x i32>)
declare {i8, <2 x i64>} @llvm.x86.aesenc128kl(<2 x i64>, ptr)
declare <2 x i64> @llvm.x86.sse4a.extrqi(<2 x i64>, i8, i8)
declare { i8, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64> } @llvm.x86.aesencwide128kl(ptr, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>)
declare { i32, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64> } @llvm.x86.encodekey128(i32, <2 x i64>)
declare void @llvm.x86.sse4a.movnt.ss(ptr, <4 x float>)
declare <8 x i32> @get_ymm()

; The dirtying 256-bit op and the SHA instructions are in the same basic block.
; One vzeroupper should cover both SHA instructions.
define <4 x i32> @sha_after_ymm(<8 x i32> %y, <4 x i32> %a, <4 x i32> %b, <4 x i32> %k, ptr %p) nounwind {
; CHECK-LABEL: sha_after_ymm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rdi)
; CHECK-NEXT:    vmovaps %xmm3, %xmm0
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    sha256rnds2 %xmm0, %xmm2, %xmm1
; CHECK-NEXT:    sha256rnds2 %xmm0, %xmm2, %xmm1
; CHECK-NEXT:    vmovaps %xmm1, %xmm0
; CHECK-NEXT:    retq
  %add = add <8 x i32> %y, %y
  store <8 x i32> %add, ptr %p
  %r1 = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %a, <4 x i32> %b, <4 x i32> %k)
  %r2 = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %r1, <4 x i32> %b, <4 x i32> %k)
  ret <4 x i32> %r2
}

; The dirty state reaches the SHA instruction across basic blocks, which is the
; shape real SHA-256 implementations have: the 256-bit operation is in the
; entry block and the compression loop is a separate block. An intra-block-only
; fix would look like it worked on the test above and do nothing here.
define <4 x i32> @sha_loop_after_ymm(<8 x i32> %y, <4 x i32> %a, <4 x i32> %b, <4 x i32> %k, ptr %p, i32 %n) nounwind {
; CHECK-LABEL: sha_loop_after_ymm:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rdi)
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    vmovdqa %xmm3, %xmm0
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    sha256rnds2 %xmm0, %xmm2, %xmm1
; CHECK-NEXT:    decl %esi
; CHECK-NEXT:    jne .LBB1_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    vmovaps %xmm1, %xmm0
; CHECK-NEXT:    retq
entry:
  %add = add <8 x i32> %y, %y
  store <8 x i32> %add, ptr %p
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi <4 x i32> [ %a, %entry ], [ %r, %loop ]
  %r = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %acc, <4 x i32> %b, <4 x i32> %k)
  %i.next = add i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret <4 x i32> %r
}

; Negative test: %ydbl is a 256-bit value that is live across the SHA
; instruction. vzeroupper would zero its upper half, so it must not be inserted
; here even though the upper state is dirty. The SHA instruction is left
; unguarded and still pays the transition penalty.
define <8 x i32> @sha_with_live_ymm(<8 x i32> %y, <4 x i32> %a, <4 x i32> %b, <4 x i32> %k, ptr %p) nounwind {
; CHECK-LABEL: sha_with_live_ymm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm4
; CHECK-NEXT:    vmovaps %xmm3, %xmm0
; CHECK-NEXT:    sha256rnds2 %xmm0, %xmm2, %xmm1
; CHECK-NEXT:    vmovaps %xmm1, (%rdi)
; CHECK-NEXT:    vmovdqa %ymm4, %ymm0
; CHECK-NEXT:    retq
  %ydbl = add <8 x i32> %y, %y
  %r = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %a, <4 x i32> %b, <4 x i32> %k)
  store <4 x i32> %r, ptr %p
  ret <8 x i32> %ydbl
}

; Same, but the live range of the 256-bit value spans basic blocks, so
; liveness has to be checked across blocks, not just within the block holding
; the SHA.
define <8 x i32> @sha_with_live_ymm_crossblock(<8 x i32> %y, <4 x i32> %a, <4 x i32> %b, <4 x i32> %k, i1 %c, ptr %p) nounwind {
; CHECK-LABEL: sha_with_live_ymm_crossblock:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm4
; CHECK-NEXT:    testb $1, %dil
; CHECK-NEXT:    je .LBB3_2
; CHECK-NEXT:  # %bb.1: # %mid
; CHECK-NEXT:    vmovdqa %xmm3, %xmm0
; CHECK-NEXT:    sha256rnds2 %xmm0, %xmm2, %xmm1
; CHECK-NEXT:    vmovaps %xmm1, (%rsi)
; CHECK-NEXT:  .LBB3_2: # %exit
; CHECK-NEXT:    vmovdqa %ymm4, %ymm0
; CHECK-NEXT:    retq
entry:
  %ydbl = add <8 x i32> %y, %y
  br i1 %c, label %mid, label %exit

mid:
  %r = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %a, <4 x i32> %b, <4 x i32> %k)
  store <4 x i32> %r, ptr %p
  br label %exit

exit:
  ret <8 x i32> %ydbl
}

; SHA-NI is not the only legacy-only family. KeyLocker has no VEX encoding
; either and takes the same penalty.
define <2 x i64> @keylocker_after_ymm(<8 x i32> %y, <2 x i64> %d, ptr %h, ptr %p) nounwind {
; CHECK-LABEL: keylocker_after_ymm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rsi)
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    aesenc128kl (%rdi), %xmm1
; CHECK-NEXT:    vmovaps %xmm1, %xmm0
; CHECK-NEXT:    retq
  %a = add <8 x i32> %y, %y
  store <8 x i32> %a, ptr %p
  %r = call {i8, <2 x i64>} @llvm.x86.aesenc128kl(<2 x i64> %d, ptr %h)
  %v = extractvalue {i8, <2 x i64>} %r, 1
  ret <2 x i64> %v
}

; So does SSE4a.
define <2 x i64> @extrq_after_ymm(<8 x i32> %y, <2 x i64> %d, ptr %p) nounwind {
; CHECK-LABEL: extrq_after_ymm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rdi)
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    extrq $2, $3, %xmm1
; CHECK-NEXT:    vmovdqa %xmm1, %xmm0
; CHECK-NEXT:    retq
  %a = add <8 x i32> %y, %y
  store <8 x i32> %a, ptr %p
  %r = call <2 x i64> @llvm.x86.sse4a.extrqi(<2 x i64> %d, i8 3, i8 2)
  ret <2 x i64> %r
}

; 512-bit dirt needs guarding just as 256-bit dirt does. Under AVX2 the wide
; add is split into two 256-bit halves; under AVX-512 it stays one ZMM
; operation. Either way the SHA instruction that follows must be guarded.
define <4 x i32> @sha_after_zmm(<16 x i32> %z, <4 x i32> %a, <4 x i32> %b, <4 x i32> %k, ptr %p) nounwind {
; AVX2-LABEL: sha_after_zmm:
; AVX2:       # %bb.0:
; AVX2-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; AVX2-NEXT:    vpaddd %ymm1, %ymm1, %ymm1
; AVX2-NEXT:    vmovdqa %ymm1, 32(%rdi)
; AVX2-NEXT:    vmovdqa %ymm0, (%rdi)
; AVX2-NEXT:    vmovaps %xmm4, %xmm0
; AVX2-NEXT:    vzeroupper
; AVX2-NEXT:    sha256rnds2 %xmm0, %xmm3, %xmm2
; AVX2-NEXT:    vmovaps %xmm2, %xmm0
; AVX2-NEXT:    retq
;
; AVX512-LABEL: sha_after_zmm:
; AVX512:       # %bb.0:
; AVX512-NEXT:    vpaddd %zmm0, %zmm0, %zmm0
; AVX512-NEXT:    vmovdqa64 %zmm0, (%rdi)
; AVX512-NEXT:    vmovaps %xmm3, %xmm0
; AVX512-NEXT:    vzeroupper
; AVX512-NEXT:    sha256rnds2 %xmm0, %xmm2, %xmm1
; AVX512-NEXT:    vmovaps %xmm1, %xmm0
; AVX512-NEXT:    retq
  %add = add <16 x i32> %z, %z
  store <16 x i32> %add, ptr %p
  %r = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %a, <4 x i32> %b, <4 x i32> %k)
  ret <4 x i32> %r
}

; Negative test: every vector instruction here is VEX/EVEX encoded, and
; VEX.128 zeroes the upper half, so nothing inside the function needs guarding
; and only the pre-existing epilogue vzeroupper is emitted.
define <4 x i32> @no_legacy_sse(<8 x i32> %y, <4 x i32> %a, <4 x i32> %b, ptr %p) nounwind {
; CHECK-LABEL: no_legacy_sse:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rdi)
; CHECK-NEXT:    vpaddd %xmm2, %xmm1, %xmm0
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
  %add = add <8 x i32> %y, %y
  store <8 x i32> %add, ptr %p
  %r = add <4 x i32> %a, %b
  ret <4 x i32> %r
}

; AESENCWIDE128KL has no explicit register operands; it writes XMM0-7 only
; through implicit defs.
define <2 x i64> @widekl_after_ymm(<8 x i32> %y, <2 x i64> %d, ptr %h, ptr %p) nounwind {
; CHECK-LABEL: widekl_after_ymm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rsi)
; CHECK-NEXT:    vmovaps %xmm1, %xmm0
; CHECK-NEXT:    vmovaps %xmm1, %xmm2
; CHECK-NEXT:    vmovaps %xmm1, %xmm3
; CHECK-NEXT:    vmovaps %xmm1, %xmm4
; CHECK-NEXT:    vmovaps %xmm1, %xmm5
; CHECK-NEXT:    vmovaps %xmm1, %xmm6
; CHECK-NEXT:    vmovaps %xmm1, %xmm7
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    aesencwide128kl (%rdi)
; CHECK-NEXT:    retq
  %a = add <8 x i32> %y, %y
  store <8 x i32> %a, ptr %p
  %r = call { i8, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64> } @llvm.x86.aesencwide128kl(ptr %h, <2 x i64> %d, <2 x i64> %d, <2 x i64> %d, <2 x i64> %d, <2 x i64> %d, <2 x i64> %d, <2 x i64> %d, <2 x i64> %d)
  %v = extractvalue { i8, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64> } %r, 1
  ret <2 x i64> %v
}

; Likewise ENCODEKEY128, whose XMM results are all implicit defs.
define <2 x i64> @encodekey_after_ymm(<8 x i32> %y, <2 x i64> %k, ptr %p) nounwind {
; CHECK-LABEL: encodekey_after_ymm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rdi)
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    vmovaps %xmm1, %xmm0
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    encodekey128 %eax, %eax
; CHECK-NEXT:    retq
  %a = add <8 x i32> %y, %y
  store <8 x i32> %a, ptr %p
  %r = call { i32, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64> } @llvm.x86.encodekey128(i32 0, <2 x i64> %k)
  %v = extractvalue { i32, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64>, <2 x i64> } %r, 1
  ret <2 x i64> %v
}

; Negative test: MOVNTSS is legacy-only but only reads its XMM operand. Reads
; do not take the transition penalty, so only the epilogue vzeroupper remains.
define void @movntss_after_ymm(<8 x i32> %y, <4 x float> %f, ptr %p, ptr %q) nounwind {
; CHECK-LABEL: movntss_after_ymm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; CHECK-NEXT:    vmovdqa %ymm0, (%rdi)
; CHECK-NEXT:    movntss %xmm1, (%rsi)
; CHECK-NEXT:    sfence
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
  %a = add <8 x i32> %y, %y
  store <8 x i32> %a, ptr %p
  call void @llvm.x86.sse4a.movnt.ss(ptr %q, <4 x float> %f)
  ret void
}

; The only 256-bit value is a function argument, so the state is dirty on
; entry. Nothing on the SHA path writes a YMM register, so only the function
; live-in check makes this block dirty.
define <4 x i32> @sha_after_ymm_arg(<8 x i32> %y, <4 x i32> %a, <4 x i32> %b, <4 x i32> %k, i1 %c, ptr %p) nounwind {
; CHECK-LABEL: sha_after_ymm_arg:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dil
; CHECK-NEXT:    je .LBB11_2
; CHECK-NEXT:  # %bb.1: # %sha
; CHECK-NEXT:    vmovaps %xmm3, %xmm0
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    sha256rnds2 %xmm0, %xmm2, %xmm1
; CHECK-NEXT:    vmovaps %xmm1, %xmm0
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB11_2: # %store
; CHECK-NEXT:    vmovaps %ymm0, (%rsi)
; CHECK-NEXT:    vmovaps %xmm1, %xmm0
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
entry:
  br i1 %c, label %sha, label %store
sha:
  %r = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %a, <4 x i32> %b, <4 x i32> %k)
  ret <4 x i32> %r
store:
  store <8 x i32> %y, ptr %p
  ret <4 x i32> %a
}

; The 256-bit value comes back from a call.
define <4 x i32> @sha_after_ymm_call(<4 x i32> %a, <4 x i32> %b, <4 x i32> %k, ptr %p) nounwind {
; CHECK-LABEL: sha_after_ymm_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    subq $48, %rsp
; CHECK-NEXT:    movq %rdi, %rbx
; CHECK-NEXT:    vmovaps %xmm2, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    vmovaps %xmm1, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    vmovaps %xmm0, (%rsp) # 16-byte Spill
; CHECK-NEXT:    callq get_ymm@PLT
; CHECK-NEXT:    vmovaps %ymm0, (%rbx)
; CHECK-NEXT:    vmovaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm0 # 16-byte Reload
; CHECK-NEXT:    vmovaps (%rsp), %xmm1 # 16-byte Reload
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    sha256rnds2 %xmm0, {{[-0-9]+}}(%r{{[sb]}}p), %xmm1 # 16-byte Folded Reload
; CHECK-NEXT:    vmovaps %xmm1, %xmm0
; CHECK-NEXT:    addq $48, %rsp
; CHECK-NEXT:    popq %rbx
; CHECK-NEXT:    retq
  %y = call <8 x i32> @get_ymm()
  store <8 x i32> %y, ptr %p
  %r = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %a, <4 x i32> %b, <4 x i32> %k)
  ret <4 x i32> %r
}

; Negative test: an interrupt handler must preserve the interrupted code's
; YMM upper halves, which appear live here, so no vzeroupper may be inserted.
@g_ymm = global <8 x i32> zeroinitializer
@g_xmm = global <4 x i32> zeroinitializer
define x86_intrcc void @sha_in_interrupt(ptr byval(i64) %frame) nounwind {
; AVX2-LABEL: sha_in_interrupt:
; AVX2:       # %bb.0:
; AVX2-NEXT:    pushq %rax
; AVX2-NEXT:    vmovups %ymm0, {{[-0-9]+}}(%r{{[sb]}}p) # 32-byte Spill
; AVX2-NEXT:    movq g_ymm@GOTPCREL(%rip), %rax
; AVX2-NEXT:    vmovdqa (%rax), %ymm0
; AVX2-NEXT:    vpaddd %ymm0, %ymm0, %ymm0
; AVX2-NEXT:    vmovdqa %ymm0, (%rax)
; AVX2-NEXT:    movq g_xmm@GOTPCREL(%rip), %rax
; AVX2-NEXT:    vmovaps (%rax), %xmm0
; AVX2-NEXT:    sha256rnds2 %xmm0, %xmm0, %xmm0
; AVX2-NEXT:    vmovaps %xmm0, (%rax)
; AVX2-NEXT:    vmovups {{[-0-9]+}}(%r{{[sb]}}p), %ymm0 # 32-byte Reload
; AVX2-NEXT:    popq %rax
; AVX2-NEXT:    iretq
;
; AVX512-LABEL: sha_in_interrupt:
; AVX512:       # %bb.0:
; AVX512-NEXT:    pushq %rax
; AVX512-NEXT:    vmovups %zmm0, {{[-0-9]+}}(%r{{[sb]}}p) # 64-byte Spill
; AVX512-NEXT:    movq g_ymm@GOTPCREL(%rip), %rax
; AVX512-NEXT:    vpslld $1, (%rax), %ymm0
; AVX512-NEXT:    vmovdqa %ymm0, (%rax)
; AVX512-NEXT:    movq g_xmm@GOTPCREL(%rip), %rax
; AVX512-NEXT:    vmovaps (%rax), %xmm0
; AVX512-NEXT:    sha256rnds2 %xmm0, %xmm0, %xmm0
; AVX512-NEXT:    vmovaps %xmm0, (%rax)
; AVX512-NEXT:    vmovups {{[-0-9]+}}(%r{{[sb]}}p), %zmm0 # 64-byte Reload
; AVX512-NEXT:    popq %rax
; AVX512-NEXT:    iretq
  %y = load <8 x i32>, ptr @g_ymm
  %y2 = add <8 x i32> %y, %y
  store <8 x i32> %y2, ptr @g_ymm
  %a = load <4 x i32>, ptr @g_xmm
  %r = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %a, <4 x i32> %a, <4 x i32> %a)
  store <4 x i32> %r, ptr @g_xmm
  ret void
}

; Win64 callee-saves only the low halves (XMM6-15), so the SHA instruction
; should still be guarded.
define win64cc <4 x i32> @sha_win64(<8 x i32> %y, <4 x i32> %a, <4 x i32> %b, <4 x i32> %k, ptr %p) nounwind {
; AVX2-LABEL: sha_win64:
; AVX2:       # %bb.0:
; AVX2-NEXT:    vmovaps (%r9), %xmm0
; AVX2-NEXT:    vmovaps (%rdx), %xmm1
; AVX2-NEXT:    vmovdqa (%rcx), %ymm2
; AVX2-NEXT:    movq {{[0-9]+}}(%rsp), %rax
; AVX2-NEXT:    vpaddd %ymm2, %ymm2, %ymm2
; AVX2-NEXT:    vmovdqa %ymm2, (%rax)
; AVX2-NEXT:    vzeroupper
; AVX2-NEXT:    sha256rnds2 %xmm0, (%r8), %xmm1
; AVX2-NEXT:    vmovaps %xmm1, %xmm0
; AVX2-NEXT:    retq
;
; AVX512-LABEL: sha_win64:
; AVX512:       # %bb.0:
; AVX512-NEXT:    vmovaps (%r9), %xmm0
; AVX512-NEXT:    vmovaps (%rdx), %xmm1
; AVX512-NEXT:    movq {{[0-9]+}}(%rsp), %rax
; AVX512-NEXT:    vpslld $1, (%rcx), %ymm2
; AVX512-NEXT:    vmovdqa %ymm2, (%rax)
; AVX512-NEXT:    vzeroupper
; AVX512-NEXT:    sha256rnds2 %xmm0, (%r8), %xmm1
; AVX512-NEXT:    vmovaps %xmm1, %xmm0
; AVX512-NEXT:    retq
  %add = add <8 x i32> %y, %y
  store <8 x i32> %add, ptr %p
  %r = call <4 x i32> @llvm.x86.sha256rnds2(<4 x i32> %a, <4 x i32> %b, <4 x i32> %k)
  ret <4 x i32> %r
}
