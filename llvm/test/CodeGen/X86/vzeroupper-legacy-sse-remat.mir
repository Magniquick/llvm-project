    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-LABEL: name: no_remat_zmm_use
    ; CHECK: liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    ; CHECK-NEXT: $xmm0 = VMOVAPSrr $xmm2
    ; CHECK-NEXT: renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    ; CHECK-NEXT: VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    ; CHECK-NEXT: VMOVDQA64Zmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $zmm3 :: (store (s512))
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: RET64
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    VMOVDQA64Zmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $zmm3 :: (store (s512))
    RET64
...
---
# Negative: $ymm3 is live out of the block and only read in its successor, so
# there is nowhere in this block to reload it.
name: no_remat_live_out
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  ; CHECK-LABEL: name: no_remat_live_out
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
  ; CHECK-NEXT:   renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
  ; CHECK-NEXT:   $xmm0 = VMOVAPSrr $xmm2
  ; CHECK-NEXT:   renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
  ; CHECK-NEXT:   VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $rsi, $ymm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
  ; CHECK-NEXT:   renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
  ; CHECK-NEXT:   VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    JMP_1 %bb.1

  bb.1:
    liveins: $rsi, $ymm3
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    RET64
...
---
# An EVEX-encoded constant-pool load is reloaded the same way, and $ymm17,
# which vzeroupper does not touch, does not block the guard.
name: remat_evex_def
tracksRegLiveness: true
