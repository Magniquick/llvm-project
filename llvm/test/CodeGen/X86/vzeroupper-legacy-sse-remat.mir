# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64-- -mattr=+avx2,+sha,+avx512f,+avx512vl,+avx512bw -passes=x86-insert-vzeroupper,verify -o - %s | FileCheck %s

# A YMM register holding a constant-pool value is live across a legacy SSE
# instruction (SHA256RNDS2): its low half is read before it and the whole
# register after it. The vzeroupper in front of the SHA instruction clobbers
# the upper half, so the constant is reloaded before that later read.

--- |
  define void @remat_after_vzeroupper() { ret void }
  define void @remat_dbg_value() { ret void }
  define void @remat_shared() { ret void }
  define void @no_remat_non_constant() { ret void }
  define void @no_remat_zmm_use() { ret void }
  define void @no_remat_live_out() { ret void }
  define void @remat_evex_def() { ret void }
  define void @remat_after_xmm_read() { ret void }
  define void @remat_two_consts() { ret void }
  define void @no_remat_overwritten() { ret void }
  define void @no_remat_live_in() { ret void }
  define void @no_remat_after_terminator() { ret void }
  define void @remat_before_tail_call() { ret void }
  define void @no_remat_after_asm_br() { ret void }
  define void @no_remat_after_invoke() personality ptr @pers { ret void }
  define void @no_remat_after_asm_unwind() personality ptr @pers { ret void }
  define void @no_remat_after_side_effect() { ret void }
  declare void @g()
  declare i32 @pers(...)
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "remat_dbg_value", scope: !1, file: !1, line: 1, type: !4, unit: !0, spFlags: DISPFlagDefinition)
  !4 = !DISubroutineType(types: !{null})
  !5 = !DILocalVariable(name: "v", scope: !3, file: !1, line: 1, type: !6)
  !6 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !7 = !DILocation(line: 1, scope: !3)
...
---
# The reload goes right before the 256-bit read of $ymm3.
name: remat_after_vzeroupper
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  bb.0:
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-LABEL: name: remat_after_vzeroupper
    ; CHECK: liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    ; CHECK-NEXT: $xmm0 = VMOVAPSrr $xmm2
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    ; CHECK-NEXT: VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    ; CHECK-NEXT: renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    ; CHECK-NEXT: VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: RET64
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    RET64
...
---
# A DBG_VALUE is not a read: the reload is placed as without it.
name: remat_dbg_value
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  bb.0:
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-LABEL: name: remat_dbg_value
    ; CHECK: liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    ; CHECK-NEXT: $xmm0 = VMOVAPSrr $xmm2
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    ; CHECK-NEXT: VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    ; CHECK-NEXT: DBG_VALUE $ymm3, $noreg, !3, !DIExpression(), debug-location !DILocation(line: 1, scope: !4)
    ; CHECK-NEXT: renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    ; CHECK-NEXT: VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: RET64
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    DBG_VALUE $ymm3, $noreg, !5, !DIExpression(), debug-location !7
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    RET64
...
---
# Two guarded SHA instructions share one later read, so one reload.
name: remat_shared
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  bb.0:
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-LABEL: name: remat_shared
    ; CHECK: liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    ; CHECK-NEXT: $xmm0 = VMOVAPSrr $xmm2
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    ; CHECK-NEXT: renamable $ymm5 = VMOVDQAYrm renamable $rsi, 1, $noreg, 32, $noreg :: (load (s256))
    ; CHECK-NEXT: VMOVDQAYmr renamable $rsi, 1, $noreg, 64, $noreg, killed renamable $ymm5 :: (store (s256))
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    ; CHECK-NEXT: VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    ; CHECK-NEXT: renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    ; CHECK-NEXT: VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: RET64
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    renamable $ymm5 = VMOVDQAYrm renamable $rsi, 1, $noreg, 32, $noreg :: (load (s256))
    VMOVDQAYmr renamable $rsi, 1, $noreg, 64, $noreg, killed renamable $ymm5 :: (store (s256))
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    RET64
...
---
# Negative: $ymm5 is also live across the SHA instruction and is not a
# constant, so nothing is inserted.
name: no_remat_non_constant
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  bb.0:
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-LABEL: name: no_remat_non_constant
    ; CHECK: liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    ; CHECK-NEXT: $xmm0 = VMOVAPSrr $xmm2
    ; CHECK-NEXT: renamable $ymm5 = VMOVDQAYrm renamable $rsi, 1, $noreg, 32, $noreg :: (load (s256))
    ; CHECK-NEXT: renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    ; CHECK-NEXT: VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    ; CHECK-NEXT: VMOVDQAYmr renamable $rsi, 1, $noreg, 64, $noreg, killed renamable $ymm5 :: (store (s256))
    ; CHECK-NEXT: renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    ; CHECK-NEXT: renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    ; CHECK-NEXT: VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: RET64
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $ymm5 = VMOVDQAYrm renamable $rsi, 1, $noreg, 32, $noreg :: (load (s256))
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    VMOVDQAYmr renamable $rsi, 1, $noreg, 64, $noreg, killed renamable $ymm5 :: (store (s256))
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    RET64
...
---
# Negative: the later read is of $zmm3, which is not reloaded.
name: no_remat_zmm_use
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
