    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    RET64
...
---
# Negative: the constant was loaded in a predecessor, so there is no load in
# this block to repeat.
name: no_remat_live_in
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  ; CHECK-LABEL: name: no_remat_live_in
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2, $ymm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
  ; CHECK-NEXT:   $xmm0 = VMOVAPSrr $xmm2
  ; CHECK-NEXT:   renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
  ; CHECK-NEXT:   VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
  ; CHECK-NEXT:   renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
  ; CHECK-NEXT:   renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
  ; CHECK-NEXT:   VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    JMP_1 %bb.1

  bb.1:
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2, $ymm3
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    RET64
...
---
# Negative: the next 256-bit read is a tail call after a conditional branch,
# and $ymm3 is also live into the branch target. A reload cannot go between
# the two terminators, so the SHA instruction stays unguarded.
name: no_remat_after_terminator
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  ; CHECK-LABEL: name: no_remat_after_terminator
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi, $edx, $xmm0, $xmm1, $xmm2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
  ; CHECK-NEXT:   renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
  ; CHECK-NEXT:   $xmm0 = VMOVAPSrr $xmm2
  ; CHECK-NEXT:   renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
  ; CHECK-NEXT:   VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
  ; CHECK-NEXT:   TEST32rr $edx, $edx, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   TCRETURNdi64 @g, 0, csr_64, implicit $rsp, implicit $ssp, implicit $ymm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $rsi, $ymm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
  ; CHECK-NEXT:   renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
  ; CHECK-NEXT:   VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1
    liveins: $rdi, $rsi, $edx, $xmm0, $xmm1, $xmm2
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    TEST32rr $edx, $edx, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    TCRETURNdi64 @g, 0, csr_64, implicit $rsp, implicit $ssp, implicit $ymm3

  bb.1:
    liveins: $rsi, $ymm3
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, killed renamable $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    RET64
...
---
# The 256-bit read is the block's only terminator, so the reload goes right
# before it.
name: remat_before_tail_call
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  bb.0:
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-LABEL: name: remat_before_tail_call
    ; CHECK: liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    ; CHECK-NEXT: $xmm0 = VMOVAPSrr $xmm2
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    ; CHECK-NEXT: VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: TCRETURNdi64 @g, 0, csr_64, implicit $rsp, implicit $ssp, implicit $ymm3
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    TCRETURNdi64 @g, 0, csr_64, implicit $rsp, implicit $ssp, implicit $ymm3
...
---
# Negative: $ymm3 is live into the indirect target of an INLINEASM_BR, which
# is not a terminator, so a reload after it would not cover that path.
name: no_remat_after_asm_br
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  ; CHECK-LABEL: name: no_remat_after_asm_br
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
  ; CHECK-NEXT:   renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
  ; CHECK-NEXT:   $xmm0 = VMOVAPSrr $xmm2
  ; CHECK-NEXT:   renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
  ; CHECK-NEXT:   VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
  ; CHECK-NEXT:   INLINEASM_BR &"jmp ${0:l}", attdialect, imm, %bb.2
  ; CHECK-NEXT:   renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
  ; CHECK-NEXT:   renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, renamable $ymm3
  ; CHECK-NEXT:   VMOVDQAYmr renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (machine-block-address-taken, inlineasm-br-indirect-target):
  ; CHECK-NEXT:   liveins: $rsi, $ymm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   VMOVDQAYmr killed renamable $rsi, 1, $noreg, 32, $noreg, killed renamable $ymm3 :: (store (s256))
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    INLINEASM_BR &"jmp ${0:l}", 0 /* attdialect */, 13 /* imm */, %bb.2
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, renamable $ymm3
    VMOVDQAYmr renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    JMP_1 %bb.1

  bb.1:
    RET64

  bb.2 (machine-block-address-taken, inlineasm-br-indirect-target):
    liveins: $rsi, $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 32, $noreg, killed renamable $ymm3 :: (store (s256))
    RET64
...
---
# Negative: $ymm3 is preserved across a call that may throw and is live into
# the landing pad, so a reload after the call would not cover that path.
name: no_remat_after_invoke
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  ; CHECK-LABEL: name: no_remat_after_invoke
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
  ; CHECK-NEXT:   renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
  ; CHECK-NEXT:   $xmm0 = VMOVAPSrr $xmm2
  ; CHECK-NEXT:   renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
  ; CHECK-NEXT:   VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp0>
  ; CHECK-NEXT:   CALL64pcrel32 @g, csr_64_rt_allregs_avx, implicit $rsp, implicit $ssp
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp1>
  ; CHECK-NEXT:   renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
  ; CHECK-NEXT:   renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, renamable $ymm3
  ; CHECK-NEXT:   VMOVDQAYmr renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (landing-pad):
  ; CHECK-NEXT:   liveins: $rsi, $ymm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   VMOVDQAYmr killed renamable $rsi, 1, $noreg, 32, $noreg, killed renamable $ymm3 :: (store (s256))
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    EH_LABEL <mcsymbol .Ltmp0>
    CALL64pcrel32 @g, csr_64_rt_allregs_avx, implicit $rsp, implicit $ssp
    EH_LABEL <mcsymbol .Ltmp1>
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, renamable $ymm3
    VMOVDQAYmr renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    JMP_1 %bb.1

  bb.1:
    RET64

  bb.2 (landing-pad):
    liveins: $rsi, $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 32, $noreg, killed renamable $ymm3 :: (store (s256))
    RET64
...
---
# Negative: the same, with inline asm that may unwind instead of a call. It has
# no side effects flag, so it is the inline asm check that stops the reload.
name: no_remat_after_asm_unwind
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  ; CHECK-LABEL: name: no_remat_after_asm_unwind
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
  ; CHECK-NEXT:   renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
  ; CHECK-NEXT:   $xmm0 = VMOVAPSrr $xmm2
  ; CHECK-NEXT:   renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
  ; CHECK-NEXT:   VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp0>
  ; CHECK-NEXT:   INLINEASM &nop, unwind attdialect
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp1>
  ; CHECK-NEXT:   renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
  ; CHECK-NEXT:   renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, renamable $ymm3
  ; CHECK-NEXT:   VMOVDQAYmr renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (landing-pad):
  ; CHECK-NEXT:   liveins: $rsi, $ymm3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   VMOVDQAYmr killed renamable $rsi, 1, $noreg, 32, $noreg, killed renamable $ymm3 :: (store (s256))
  ; CHECK-NEXT:   VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    VMOVAPSmr renamable $rdi, 1, $noreg, 0, $noreg, renamable $xmm4 :: (store (s128))
    EH_LABEL <mcsymbol .Ltmp0>
    INLINEASM &"nop", 64 /* attdialect unwind */
    EH_LABEL <mcsymbol .Ltmp1>
    renamable $ymm0 = VMOVDQAYrm renamable $rsi, 1, $noreg, 0, $noreg :: (load (s256))
    renamable $ymm0 = VPSHUFBYrr killed renamable $ymm0, renamable $ymm3
    VMOVDQAYmr renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm0 :: (store (s256))
    JMP_1 %bb.1

  bb.1:
    RET64

  bb.2 (landing-pad):
    liveins: $rsi, $ymm3
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 32, $noreg, killed renamable $ymm3 :: (store (s256))
    RET64
...
---
# Negative: XSAVE stores the full register state, including the upper half of
# $ymm3, before the 256-bit read, so a reload after it would be too late.
name: no_remat_after_side_effect
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: '<32 x i8> <i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12, i8 3, i8 2, i8 1, i8 0, i8 7, i8 6, i8 5, i8 4, i8 11, i8 10, i8 9, i8 8, i8 15, i8 14, i8 13, i8 12>'
    alignment: 32
body: |
  bb.0:
    liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2, $eax, $edx
    ; CHECK-LABEL: name: no_remat_after_side_effect
    ; CHECK: liveins: $rdi, $rsi, $xmm0, $xmm1, $xmm2, $eax, $edx
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    ; CHECK-NEXT: renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    ; CHECK-NEXT: $xmm0 = VMOVAPSrr $xmm2
    ; CHECK-NEXT: renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    ; CHECK-NEXT: XSAVE $rdi, 1, $noreg, 0, $noreg, implicit $edx, implicit $eax
    ; CHECK-NEXT: VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm3 :: (store (s256))
    ; CHECK-NEXT: VZEROUPPER implicit-def $ymm0, implicit-def $ymm1, implicit-def $ymm2, implicit-def $ymm3, implicit-def $ymm4, implicit-def $ymm5, implicit-def $ymm6, implicit-def $ymm7, implicit-def $ymm8, implicit-def $ymm9, implicit-def $ymm10, implicit-def $ymm11, implicit-def $ymm12, implicit-def $ymm13, implicit-def $ymm14, implicit-def $ymm15
    ; CHECK-NEXT: RET64
    renamable $ymm3 = VMOVDQAYrm $rip, 1, $noreg, %const.0, $noreg :: (load (s256) from constant-pool)
    renamable $xmm4 = VPSHUFBrr killed renamable $xmm0, renamable $xmm3
    $xmm0 = VMOVAPSrr $xmm2
    renamable $xmm4 = SHA256RNDS2rr killed renamable $xmm4, renamable $xmm1, implicit $xmm0
    XSAVE $rdi, 1, $noreg, 0, $noreg, implicit $edx, implicit $eax
    VMOVDQAYmr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $ymm3 :: (store (s256))
    RET64
...
